---
// Fondo procedural: gotas de pintura (rojo de marca) que caen, se estiran y al
// impactar SALPICAN (subgotas + mancha que se difumina + goteo ocasional en la
// pared). Canvas fijo detrás del contenido; se ve en las secciones oscuras (las
// rojas, opacas, lo tapan). Respeta prefers-reduced-motion. Sin dependencias.
---

<canvas id="fondo-gotas" aria-hidden="true"></canvas>

<script>
  (() => {
    const cv = document.getElementById('fondo-gotas') as HTMLCanvasElement | null;
    if (!cv) return;
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = 0,
      H = 0;
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      cv.width = Math.floor(W * dpr);
      cv.height = Math.floor(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const R = (a: number, b: number) => a + Math.random() * (b - a);
    // Rojos de marca vivos (con brillo) para que destaquen sobre el negro.
    const COLORS = [
      [214, 42, 47],
      [232, 66, 70],
      [245, 92, 94],
      [190, 32, 37],
      [232, 66, 70]
    ];
    const pick = () => COLORS[(Math.random() * COLORS.length) | 0];
    const rgba = (c: number[], a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a < 0 ? 0 : a})`;
    const SHEEN = 'rgba(255,224,220,'; // reflejo húmedo

    type Drop = { x: number; y: number; vx: number; vy: number; r: number; c: number[]; a: number; impactY: number; sub?: boolean; life?: number };
    type Splat = { x: number; y: number; rx: number; ry: number; a: number; decay: number; c: number[] };
    type Drip = { x: number; y: number; len: number; maxLen: number; w: number; c: number[]; a: number; speed: number; head: number };
    const drops: Drop[] = [];
    const splats: Splat[] = [];
    const drips: Drip[] = [];
    const MAX_DROPS = W < 640 ? 14 : 22;

    const spawn = () => {
      const c = pick();
      drops.push({ x: R(0, W), y: -30, vx: R(-0.15, 0.15), vy: R(1.3, 2.8), r: R(2, 5.4), c, a: R(0.55, 0.85), impactY: R(H * 0.2, H * 0.98) });
    };

    const splash = (x: number, y: number, r: number, c: number[], a: number) => {
      splats.push({ x, y, rx: r * R(2, 3.6), ry: r * R(0.8, 1.5), a: a * 0.72, decay: R(0.006, 0.014), c });
      const n = 4 + ((Math.random() * 5) | 0);
      for (let i = 0; i < n; i++) {
        const ang = R(0, Math.PI * 2);
        const sp = R(1, 4.2);
        drops.push({ x, y, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp - R(0.5, 2.4), r: R(0.7, 2), c, a: a * 0.85, sub: true, life: R(0.5, 1), impactY: H + 50 });
      }
      if (Math.random() < 0.3) {
        drips.push({ x, y, len: 0, maxLen: R(20, 90), w: R(1.2, 2.6), c, a: a * 0.7, speed: R(0.25, 0.8), head: r * R(1, 1.8) });
      }
    };

    let acc = 0;
    let last = 0;
    let nextSpawn = R(120, 280);
    const frame = (t: number) => {
      const dt = Math.min(t - (last || t), 40);
      last = t;
      acc += dt;
      if (acc > nextSpawn) {
        acc = 0;
        nextSpawn = R(130, 300);
        if (drops.filter((d) => !d.sub).length < MAX_DROPS) spawn();
      }
      ctx.clearRect(0, 0, W, H);

      // Manchas de impacto (al fondo).
      for (let i = splats.length - 1; i >= 0; i--) {
        const s = splats[i];
        s.a -= s.decay;
        if (s.a <= 0) {
          splats.splice(i, 1);
          continue;
        }
        ctx.fillStyle = rgba(s.c, s.a);
        ctx.beginPath();
        ctx.ellipse(s.x, s.y, s.rx, s.ry, 0, 0, Math.PI * 2);
        ctx.fill();
      }
      // Goteo en la pared.
      for (let i = drips.length - 1; i >= 0; i--) {
        const d = drips[i];
        if (d.len < d.maxLen) d.len += d.speed;
        else d.a -= 0.008;
        if (d.a <= 0) {
          drips.splice(i, 1);
          continue;
        }
        ctx.fillStyle = rgba(d.c, d.a);
        ctx.fillRect(d.x - d.w / 2, d.y, d.w, d.len);
        ctx.beginPath();
        ctx.arc(d.x, d.y + d.len, d.head, 0, Math.PI * 2);
        ctx.fill();
      }
      // Gotas que caen.
      for (let i = drops.length - 1; i >= 0; i--) {
        const d = drops[i];
        d.vy += 0.09;
        d.x += d.vx;
        d.y += d.vy;
        if (d.sub) {
          d.life! -= 0.022;
          if (d.life! <= 0 || d.y > H + 20) {
            drops.splice(i, 1);
            continue;
          }
        }
        const stretch = Math.min(d.vy * 1.4, 15);
        const alpha = d.a * (d.sub ? Math.max(0, d.life!) : 1);
        // Cuerpo de la gota con un ligero halo para que "brille" sobre el negro.
        ctx.shadowColor = rgba(d.c, alpha * 0.6);
        ctx.shadowBlur = d.sub ? 4 : 9;
        ctx.fillStyle = rgba(d.c, alpha);
        ctx.beginPath();
        ctx.ellipse(d.x, d.y, d.r, d.r + stretch, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
        // Reflejo húmedo en las gotas grandes (no en las subgotas diminutas).
        if (!d.sub && d.r > 2.4) {
          ctx.fillStyle = SHEEN + (alpha * 0.55).toFixed(3) + ')';
          ctx.beginPath();
          ctx.ellipse(d.x - d.r * 0.3, d.y - stretch * 0.15, d.r * 0.34, (d.r + stretch) * 0.3, 0, 0, Math.PI * 2);
          ctx.fill();
        }
        if (!d.sub && d.y >= d.impactY) {
          splash(d.x, d.impactY, d.r, d.c, d.a);
          drops.splice(i, 1);
          continue;
        }
        if (d.y > H + 40) drops.splice(i, 1);
      }
      requestAnimationFrame(frame);
    };

    if (!REDUCE) {
      // Arranca con algunas manchas para no empezar en vacío.
      for (let i = 0; i < 5; i++) splash(R(0, W), R(H * 0.3, H * 0.9), R(2, 4), pick(), 0.45);
      requestAnimationFrame(frame);
    }
  })();
</script>
