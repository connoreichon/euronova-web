---
// Aviso profesional sobre la variación del color en pantalla. Rojo de marca,
// legible, integrado con gusto (filete rojo a la izquierda), sin alarmismo.
// `variant`: 'full' (con encabezado) | 'inline' (compacto de una línea).
interface Props {
  variant?: 'full' | 'inline';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{
  variant === 'inline' ? (
    <p class={`aviso-tricolor pl-3.5 text-[12.5px] leading-relaxed text-papel/70 ${className}`}>
      <span class="font-semibold text-rojo-400">El color en pantalla es orientativo.</span>{' '}
      Para acertar, ven con una muestra real o consulta la carta física en tienda.
    </p>
  ) : (
    <div class={`nota-mostrador nota-mostrador--salpicada flex items-start gap-4 p-4 pr-5 ${className}`}>
      <span class="nota-mostrador__sello" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
          <path d="M12 2.7c.27 0 .52.13.68.36C14.7 5.9 18 10.5 18 13.9A6 6 0 0 1 6 14c0-3.4 3.3-8 5.32-10.94.16-.23.41-.36.68-.36Z" />
          <circle cx="9.4" cy="14.4" r="1.9" fill="#fff" opacity="0.5" />
        </svg>
      </span>
      <div class="nota-mostrador__cuerpo">
        <p class="nota-mostrador__titulo">
          <span class="nota-mostrador__gama" aria-hidden="true">
            <i style="background:#d2262b"></i>
            <i style="background:#d9a441"></i>
            <i style="background:#2a5cad"></i>
          </span>
          Nota del mostrador
        </p>
        <p class="nota-mostrador__texto">
          El color en pantalla es <strong>orientativo</strong>: cada dispositivo,
          brillo y luz alteran el tono. Para acertar, ven con una muestra real o
          consulta la carta física en tienda — te asesoramos según soporte, uso y
          acabado.
        </p>
      </div>
    </div>
  )
}
