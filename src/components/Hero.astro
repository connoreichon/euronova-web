---
// HERO principal (rediseño quirúrgico): rojo ATMOSFÉRICO —capas de luz,
// pigmento sutil y viñeta— con jerarquía editorial: eyebrow → H1 que vende →
// copy de mostrador → 2 CTAs → banda de confianza. El logo vive en la
// navegación; aquí manda el titular. La foto se trata como pieza hero (losa
// granate desplazada + chip de "color a medida"), no como card.
import { site, opiniones, productosDestacados } from '../data/site';
import { asset } from '../lib/asset';

// Tira de "carta de colores" del hero: paleta curada (cálidos → tierra → verdes
// → azules → neutros), como un muestrario desplegado. Muestras reales de la carta
// RAL Clásico (código, nombre y su sRGB estándar). Al pulsar una, se abre la ficha
// grande a pantalla (compartida con /cartas) para verla y guardarla en favoritos.
const CARTA = [
  { h: '#E9E0D2', c: 'RAL 9001', n: 'Blanco crema' },
  { h: '#E6D2B5', c: 'RAL 1015', n: 'Marfil claro' },
  { h: '#BA8F4C', c: 'RAL 1024', n: 'Amarillo ocre' },
  { h: '#A65E2F', c: 'RAL 8023', n: 'Naranja tierra' },
  { h: '#A73A2E', c: 'RAL 3013', n: 'Rojo teja' },
  { h: '#5E2028', c: 'RAL 3005', n: 'Rojo vino' },
  { h: '#826C34', c: 'RAL 8000', n: 'Pardo verdoso' },
  { h: '#7C765A', c: 'RAL 6013', n: 'Verde caña' },
  { h: '#587246', c: 'RAL 6011', n: 'Verde reseda' },
  { h: '#1F3A3D', c: 'RAL 6004', n: 'Verde azulado' },
  { h: '#256D7B', c: 'RAL 5021', n: 'Azul agua' },
  { h: '#26363B', c: 'RAL 5008', n: 'Azul grisáceo' },
  { h: '#6C6960', c: 'RAL 7006', n: 'Gris beige' },
  { h: '#B9B9A8', c: 'RAL 7032', n: 'Gris sílice' }
];
const estrella =
  'M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z';
---

<section id="top" class="hero-fondo pt-28 pb-20 text-white md:pt-36 md:pb-24">
  <div class="container-x grid items-center gap-14 md:grid-cols-[1.06fr_1fr] lg:gap-16">
    <!-- Columna de contenido -->
    <div class="hero-anim">
      <p class="kicker text-white/85">{site.nombre} · Las Lagunas de Mijas</p>
      <h1 class="display mt-4 max-w-[21ch] text-[clamp(2.4rem,4.4vw,3.9rem)] leading-[1.04] text-white">
        Color a medida y asesoramiento experto para pintar sin fallar.
      </h1>
      <p class="mt-5 max-w-[560px] text-[15.5px] leading-relaxed text-white/95">
        Te ayudamos a elegir la pintura adecuada según superficie, uso, acabado
        y color. En tienda, con carta física, muestra real y experiencia de
        mostrador.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={site.mapsLink}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-white px-7 py-3.5 text-[14.5px] font-bold text-rojo-700 shadow-[0_10px_24px_-12px_rgba(60,8,10,0.8)] transition-all hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-12px_rgba(60,8,10,0.9)]"
        >
          Cómo llegar a la tienda
        </a>
        <a
          href={asset('/cartas/')}
          class="rounded-full border border-white/55 px-7 py-3.5 text-[14.5px] font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
        >
          Ver cartas de colores
        </a>
      </div>

      <!-- Prueba social: valoración REAL de Google -->
      <a
        href={site.mapsLink}
        target="_blank"
        rel="noopener"
        class="mt-4 inline-flex items-center gap-2 text-[13px] text-white/90 transition-colors hover:text-white"
        aria-label={`Valoración ${opiniones.nota} sobre 5 en Google con ${opiniones.total} reseñas`}
      >
        <span class="flex gap-0.5" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => (
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-albero"><path d={estrella} /></svg>
          ))}
        </span>
        <span class="font-bold text-white">{opiniones.nota}</span>
        <span class="text-white/75">· {opiniones.total} reseñas en Google</span>
      </a>
      <!-- Aviso de color: panel CLARO (no rojo sobre rojo), acento de muestra -->
      <div class="mt-5 flex max-w-[520px] items-center gap-3 rounded-xl border border-white/20 bg-white/[0.12] px-4 py-3 shadow-[0_12px_28px_-16px_rgba(30,4,6,0.85)] ring-1 ring-inset ring-white/10 backdrop-blur-sm">
        <span class="flex shrink-0 gap-0.5" aria-hidden="true">
          <span class="h-6 w-2.5 rounded-[2px] bg-[#f2e9d8]"></span>
          <span class="h-6 w-2.5 rounded-[2px] bg-[#d9a441]"></span>
        </span>
        <p class="text-[12.5px] leading-snug text-white">
          <span class="font-semibold">El color en pantalla es orientativo.</span>{' '}
          Para acertar, ven con una muestra real o consulta la carta física en tienda.
        </p>
      </div>

      <!-- Confianza: tira de "muestras" (cuadrado de color + dato) -->
      <div class="mt-9 flex flex-wrap items-center gap-2.5 border-t border-white/20 pt-5">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-[12.5px] font-semibold text-white shadow-[0_6px_16px_-12px_rgba(30,4,6,0.7)] ring-1 ring-white/15 backdrop-blur-sm transition-colors hover:bg-white/[0.16]">
          <span class="h-2.5 w-2.5 shrink-0 rounded-[2px] bg-[#f2e9d8]" aria-hidden="true"></span>
          +<span data-count="20">20</span> años asesorando
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-[12.5px] font-semibold text-white shadow-[0_6px_16px_-12px_rgba(30,4,6,0.7)] ring-1 ring-white/15 backdrop-blur-sm transition-colors hover:bg-white/[0.16]">
          <span class="h-2.5 w-2.5 shrink-0 rounded-[2px] bg-[#d9a441]" aria-hidden="true"></span>
          Color a medida en tienda
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-[12.5px] font-semibold text-white shadow-[0_6px_16px_-12px_rgba(30,4,6,0.7)] ring-1 ring-white/15 backdrop-blur-sm transition-colors hover:bg-white/[0.16]">
          <span class="h-2.5 w-2.5 shrink-0 rounded-[2px] bg-[#2a5cad]" aria-hidden="true"></span>
          Particulares y profesionales
        </span>
      </div>
    </div>

    <!-- Pieza visual: ESCAPARATE de productos destacados (los botes van pasando). -->
    <div class="parallax relative mt-2 md:mt-0" data-parallax="0.05">
      <div class="hero-marco relative">
        <div class="hero-showcase">
          {
            productosDestacados.map((p, i) => (
              <img
                src={`${asset(p.img)}?v=6`}
                alt={`${p.marca} ${p.nombre}`}
                class={`hero-showcase__img ${i === 0 ? 'is-on' : ''}`}
                data-marca={p.marca}
                data-nombre={p.nombre}
                width="760"
                height="760"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            ))
          }
        </div>
        <!-- Etiqueta del producto en escena (se actualiza con el pase) -->
        <div class="absolute -bottom-5 left-4 rounded-xl bg-white/95 px-4 py-2.5 shadow-lg shadow-rojo-900/35 backdrop-blur-sm">
          <span id="hero-showcase-marca" class="block text-[10px] font-extrabold tracking-[0.14em] text-rojo uppercase">
            {productosDestacados[0].marca}
          </span>
          <span id="hero-showcase-nombre" class="block text-[13px] leading-tight font-bold text-negro">
            {productosDestacados[0].nombre}
          </span>
        </div>
        <!-- Flechas sutiles para pasar al bote anterior / siguiente -->
        <div class="absolute -bottom-5 right-4 flex gap-2">
          <button type="button" class="hero-showcase__nav" data-dir="prev" aria-label="Producto anterior">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="hero-showcase__nav" data-dir="next" aria-label="Producto siguiente">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Tira de color: muro de color real — cualquier tono, a medida en tienda -->
  <div class="container-x mt-12 md:mt-16">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-white/20 pt-5">
      <p class="text-[12.5px] font-semibold text-white/90">
        Cualquier color RAL o NCS, mezclado a medida en tienda.
      </p>
      <a
        href={asset('/cartas/')}
        class="text-[12.5px] font-bold text-white underline-offset-4 hover:underline"
      >
        Ver las cartas de colores →
      </a>
    </div>
    <div id="hero-carta" class="mt-3 flex flex-wrap gap-1.5">
      {
        CARTA.map((c) => (
          <button
            type="button"
            class="hero-swatch h-9 min-w-[2rem] flex-1 cursor-pointer rounded-[3px] ring-1 ring-black/10 md:h-11"
            style={`background:${c.h}`}
            data-hex={c.h}
            data-codigo={c.c}
            data-nombre={c.n}
            aria-label={`${c.c} · ${c.n} — pulsa para verlo en grande y guardarlo`}
          />
        ))
      }
    </div>
    <p class="mt-2.5 text-[11.5px] text-white/60">
      Pulsa una muestra para verla en grande y guardarla en tus colores.
    </p>
  </div>

  <!-- Escaparate del hero: los botes van pasando en bucle (cross-fade) y la etiqueta
       se actualiza con el producto en escena. -->
  <script>
    const scImgs = Array.from(document.querySelectorAll('.hero-showcase__img'));
    if (scImgs.length > 1) {
      const capM = document.getElementById('hero-showcase-marca');
      const capN = document.getElementById('hero-showcase-nombre');
      let idx = 0;
      let timer;
      const mostrar = (n) => {
        scImgs[idx].classList.remove('is-on');
        idx = (n + scImgs.length) % scImgs.length;
        scImgs[idx].classList.add('is-on');
        if (capM) capM.textContent = scImgs[idx].dataset.marca || '';
        if (capN) capN.textContent = scImgs[idx].dataset.nombre || '';
      };
      const auto = () => {
        clearInterval(timer);
        timer = setInterval(() => mostrar(idx + 1), 3200);
      };
      document.querySelectorAll('.hero-showcase__nav').forEach((b) =>
        b.addEventListener('click', () => {
          mostrar(idx + (b.dataset.dir === 'prev' ? -1 : 1));
          auto(); // reinicia el temporizador tras pasar a mano
        })
      );
      auto();
    }
  </script>
</section>

<!-- Transición limpia hacia la sección siguiente: el rojo se asienta en la sombra -->
<div class="hero-seam" aria-hidden="true"></div>
