# Cloudflare Pages — cabeceras de seguridad y caché.
# Este archivo se copia a dist/_headers y Cloudflare lo aplica automáticamente.

/*
  # Seguridad
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  # CSP: web estática. 'unsafe-inline' es necesario porque el sitio usa scripts y
  # estilos en línea (Astro/Tailwind). Externos permitidos: Google Fonts y el
  # iframe del mapa de Google. Sin fetch/XHR externos.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Assets con hash de Astro: inmutables, caché larga.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes propias: caché CORTA mientras iteramos con el cliente (así los cambios de
# imágenes con el mismo nombre —logo, fachada, fotos— se ven pronto). Subir a
# max-age=2592000 (30 días) cuando la web esté cerrada para producción.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
